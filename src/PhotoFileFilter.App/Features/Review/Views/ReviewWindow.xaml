                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="{loc:Translate Key='Restore Defaults'}" Click="OnResetSettings"/><Button Content="{loc:Translate Key='Close'}" Click="OnCloseSettings" Style="{StaticResource BlueButton}" Margin="8,0,0,0" Padding="20,8"/></StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
