<Window x:Class="PhotoFileFilter.Features.TxtFilter.Views.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="clr-namespace:PhotoFileFilter.Shared.Localization"
        Title="{loc:Translate Key='Photo Preview · QiQi Studio'}" Icon="/PhotoFileFilter;component/Assets/qiqistudio.ico" Width="1000" Height="740" MinWidth="620" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" PreviewKeyDown="OnPreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="{loc:Translate Key='Show in File Explorer ↗'}" Click="OnReveal"/><StackPanel><TextBlock x:Name="FileTitle" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="PreviewHelp" Text="{loc:Translate Key='← / → browse · Wheel to zoom · Drag to pan · R rotate · Esc close'}" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></DockPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,10"><Button x:Name="PreviousButton" Content="{loc:Translate Key='←'}" Click="OnPrevious" ToolTip="{loc:Translate Key='Previous photo'}"/><TextBlock x:Name="PositionText" VerticalAlignment="Center" Margin="10,0"/><Button x:Name="NextButton" Content="{loc:Translate Key='→'}" Click="OnNext" ToolTip="{loc:Translate Key='Next photo'}"/><Button Content="{loc:Translate Key='−'}" Click="OnZoomOut" Margin="16,0,0,0" ToolTip="{loc:Translate Key='Zoom out'}"/><TextBlock x:Name="ZoomText" VerticalAlignment="Center" Margin="10,0"/><Button Content="{loc:Translate Key='+'}" Click="OnZoomIn" ToolTip="{loc:Translate Key='Zoom in'}"/><Button x:Name="FitButton" Content="{loc:Translate Key='Fit'}" Click="OnFit" Margin="8,0,0,0"/><Button x:Name="RotateButton" Content="{loc:Translate Key='Rotate 90°'}" Click="OnRotate" Margin="8,0,0,0"/></WrapPanel>
        <Grid Grid.Row="2" x:Name="ImageViewport" Background="{DynamicResource C14232B}" ClipToBounds="True" PreviewMouseWheel="OnWheel" MouseLeftButtonDown="OnPanDown" MouseMove="OnPanMove" MouseLeftButtonUp="OnPanUp" LostMouseCapture="OnLostCapture">
            <Image x:Name="PreviewImage" Stretch="Uniform" Margin="12" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="HighQuality"><Image.LayoutTransform><RotateTransform x:Name="ImageRotation"/></Image.LayoutTransform><Image.RenderTransform><TransformGroup><ScaleTransform x:Name="ImageScale"/><TranslateTransform x:Name="ImagePan"/></TransformGroup></Image.RenderTransform></Image>
        </Grid>
        <TextBlock Grid.Row="3" x:Name="PreviewDescription" Text="{loc:Translate Key='Loading photo…'}" Margin="0,12,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
