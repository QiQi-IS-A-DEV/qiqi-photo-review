<Window x:Class="PhotoFileFilter.ReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:review="clr-namespace:PhotoFileFilter.Review"
        xmlns:services="clr-namespace:PhotoFileFilter.Services"
        Title="{x:Static services:AppInfo.ReviewTitle}" Icon="Assets/qiqistudio.ico"
        Width="1480" Height="920" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#202020" Foreground="#E6E6E6"
        FontFamily="Segoe UI" FontSize="12" PreviewKeyDown="OnReviewKeyDown"
        AllowDrop="True" PreviewDragOver="OnReviewDragOver" Drop="OnReviewDrop">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#252525"/>
        <SolidColorBrush x:Key="Panel2" Color="#2D2D2D"/>
        <SolidColorBrush x:Key="Rule" Color="#3F3F3F"/>
        <SolidColorBrush x:Key="Blue" Color="#3B9BD6"/>
        <review:RatingBrushConverter x:Key="RatingBrush"/>
        <DropShadowEffect x:Key="StarOutline" Color="Black" BlurRadius="2" ShadowDepth="0" Opacity="0.9"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E4E4E4"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#343434"/><Setter Property="Foreground" Value="#EAEAEA"/><Setter Property="BorderBrush" Value="#4A4A4A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,6"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#464646"/><Setter TargetName="B" Property="BorderBrush" Value="#666"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#292929"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.32"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="BlueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#287CAD"/><Setter Property="BorderBrush" Value="#3B9BD6"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D8D8D8"/><Setter Property="Margin" Value="0,4"/></Style>
        <Style x:Key="PanelExpander" TargetType="Expander"><Setter Property="Foreground" Value="#E4E4E4"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Rule}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        <Style TargetType="ContextMenu"><Setter Property="Background" Value="#242424"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#696969"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style TargetType="MenuItem"><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="Background" Value="#242424"/><Setter Property="Padding" Value="7,5"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3B6F8F"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#999"/></Trigger></Style.Triggers></Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAA"/><Setter Property="Padding" Value="9,8"/><Setter Property="FontSize" Value="11"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" Background="#222" BorderBrush="#444" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="White"/><Setter TargetName="TabBorder" Property="Background" Value="#303030"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#3B9BD6"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ReviewListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#1C1C1C"/><Setter Property="Foreground" Value="#EEE"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}" HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}" VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}"><ItemsPresenter/></ScrollViewer></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Cell" Background="{TemplateBinding Background}" BorderBrush="#484848" BorderThickness="1" Padding="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Cell" Property="BorderBrush" Value="{StaticResource Blue}"/><Setter TargetName="Cell" Property="BorderThickness" Value="3"/><Setter TargetName="Cell" Property="Padding" Value="1"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Cell" Property="Background" Value="#373737"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="PhotoTile">
            <Grid Loaded="OnPhotoTileLoaded" Width="{Binding DataContext.ThumbnailSize, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding DataContext.ThumbnailHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" Background="{Binding ColorBackgroundHex}">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="37"/></Grid.RowDefinitions>
                <Border Background="#151515" Margin="6,5,6,0"><Grid><TextBlock Text="PHOTO" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Grid></Border>
                <Grid Grid.Row="1" Margin="7,4,7,2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" Foreground="{Binding TileTextHex}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="{Binding Stars}" Foreground="#F2C14E" Effect="{StaticResource StarOutline}" FontSize="10"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding FlagLabel}" FontSize="9" FontWeight="Bold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#7BE49E"/><Style.Triggers><DataTrigger Binding="{Binding IsRejected}" Value="True"><Setter Property="Foreground" Value="#FF7777"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Border Width="9" Height="9" Margin="0,2,0,0" HorizontalAlignment="Right" Background="{Binding ColorHex}" BorderBrush="#111" BorderThickness="1"/></StackPanel></Grid>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FilmTile">
            <Grid Loaded="OnPhotoTileLoaded" Width="{Binding DataContext.FilmThumbWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" Height="{Binding DataContext.FilmThumbHeight, RelativeSource={RelativeSource AncestorType=ListBox}}" Background="{Binding ColorBackgroundHex}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="20"/></Grid.RowDefinitions><Border Background="#151515" Margin="4,3,4,0"><Image Source="{Binding Thumbnail}" Stretch="Uniform"/></Border><Grid Grid.Row="1" Margin="5,0"><TextBlock Text="{Binding Stars}" Foreground="#F2C14E" Effect="{StaticResource StarOutline}" FontSize="9" VerticalAlignment="Center"/><TextBlock Text="{Binding FlagLabel}" Foreground="#7BE49E" FontSize="8" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <Grid x:Name="ReviewScreen">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition x:Name="FilmstripRow" Height="{Binding FilmstripRowHeight}"/><RowDefinition Height="28"/></Grid.RowDefinitions>

        <Border Background="#111" BorderBrush="#3C3C3C" BorderThickness="0,0,0,1" Padding="15,0">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/qiqistudio_nobackground.png" Width="34" Height="34"/><StackPanel Margin="10,0,18,0" VerticalAlignment="Center"><TextBlock Text="QIQI STUDIO" FontWeight="SemiBold" FontSize="11"/><TextBlock Text="IMPORT &amp; REVIEW" Foreground="#888" FontSize="9"/></StackPanel><Button x:Name="ZenButton" Content="Hide panels" Click="OnToggleZen" ToolTip="Show or hide both side panels (Tab)"/><Button Content="Help" Click="OnShowHelp" Margin="7,0,0,0" ToolTip="Open the user guide (F1)"/><Button Content="Settings" Click="OnShowSettings" Margin="7,0,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Library" Foreground="{StaticResource Blue}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="  /  Import → Review → Deliver" Foreground="#858585" FontSize="11"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#287CAD" BorderBrush="#3B9BD6" BorderThickness="1" CornerRadius="3" Padding="12,7"><TextBlock Text="Review  ·  Ctrl+1" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap"/></Border><Button Content="TXT Filter  ·  Ctrl+2" Click="OnOpenFilter" Margin="7,0,0,0" ToolTip="Switch to filename matching and RAW copy (Ctrl+2)"/><Button Content="Import folder…" Command="{Binding ImportCommand}" Style="{StaticResource BlueButton}" Margin="7,0,0,0"/></StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="NavigatorColumn" Width="240"/><ColumnDefinition x:Name="LeftSplitterColumn" Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightSplitterColumn" Width="5"/><ColumnDefinition x:Name="RatingColumn" Width="255"/></Grid.ColumnDefinitions>

            <Border Background="{StaticResource Panel}" BorderBrush="#111" BorderThickness="0,0,1,0">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                        <Expander Header="Navigator" IsExpanded="True" Style="{StaticResource PanelExpander}">
                            <Border Background="#171717" Height="205" Margin="0,8,0,2"><Grid ClipToBounds="True"><TextBlock Text="NO PREVIEW" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding PreviewImage}" Stretch="Uniform"><Image.LayoutTransform><RotateTransform Angle="{Binding CurrentPhoto.Rotation}"/></Image.LayoutTransform></Image></Grid></Border>
                        </Expander>
                        <Expander Header="Photo Source" IsExpanded="True" Style="{StaticResource PanelExpander}">
                            <StackPanel Margin="2,8,2,4"><TextBlock Text="CURRENT IMPORT" Foreground="#8C8C8C" FontSize="9"/><TextBlock Text="{Binding FolderName}" FontSize="13" FontWeight="SemiBold" Margin="0,7,0,3" TextWrapping="Wrap"/><TextBlock Text="{Binding Folder}" Foreground="#A5A5A5" FontSize="10" TextWrapping="Wrap" ToolTip="{Binding Folder}" MaxHeight="52"/><WrapPanel Margin="0,8,0,0"><Button Content="{Binding CopyFolderLabel}" Click="OnCopyFolder" IsEnabled="{Binding HasSourceFolder}" Padding="7,5" FontSize="10"/><Button Content="{Binding OpenFolderLabel}" Click="OnOpenSourceFolder" IsEnabled="{Binding HasSourceFolder}" Padding="7,5" FontSize="10" Margin="5,0,0,0"/></WrapPanel><CheckBox Content="Include subfolders" IsChecked="{Binding Recursive}" Margin="0,14,0,0"/><TextBlock Text="You can also drag and drop one or more photos, or an entire folder, anywhere in this window." Foreground="#999" FontSize="10" Margin="0,8,0,0" LineHeight="15"/></StackPanel>
                        </Expander>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="1" Margin="10"><Button Content="Import folder…" Command="{Binding ImportCommand}"/><Button Content="Cancel import" Command="{Binding CancelCommand}" Margin="0,6,0,0"/></StackPanel>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" Background="#151515" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Background="#1C1C1C">
                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Background="#2B2B2B" BorderBrush="#111" BorderThickness="0,0,0,1" Padding="10,0"><DockPanel LastChildFill="False"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="G  Grid" ToolTip="Grid / Loupe: Space" Command="{Binding GridCommand}" Padding="8,5"/><Button Content="E  Loupe" ToolTip="Grid / Loupe: Space" Command="{Binding LoupeCommand}" Padding="8,5" Margin="5,0,0,0"/></StackPanel><ComboBox DockPanel.Dock="Right" ItemsSource="{Binding Filters}" SelectedIndex="{Binding FilterIndex}" Width="150" Margin="10,0,0,0" VerticalAlignment="Center"/></DockPanel></Border>

                <Border Grid.Row="2" Background="#2B2B2B" Padding="12,7" Visibility="{Binding IsGrid, Converter={StaticResource BoolVisibility}}">
                    <DockPanel><TextBlock Text="{Binding ThumbnailSizeLabel}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBlock DockPanel.Dock="Right" Text="{Binding ThumbnailSize, StringFormat={}{0} px}" VerticalAlignment="Center" Margin="12,0,0,0"/><Slider x:Name="ThumbnailSlider" Minimum="100" Maximum="400" TickFrequency="10" IsSnapToTickEnabled="True" Value="{Binding ThumbnailSize, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="Thumbnail size"/></DockPanel>
                </Border>
                <Grid Grid.Row="1">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Export selected photos…" Click="OnContextExport" FontWeight="SemiBold"/>
                            <MenuItem Header="Export selected filenames to TXT…" Click="OnContextExportNames"/>
                            <MenuItem Header="Send selected filenames to TXT Filter" Click="OnContextSendToFilter"/>
                            <Separator/>
                            <MenuItem Header="Set Rating">
                                <MenuItem Header="0 · Clear rating" Tag="0" Click="OnContextRating"/>
                                <MenuItem Header="1 star" Tag="1" Click="OnContextRating"/><MenuItem Header="2 stars" Tag="2" Click="OnContextRating"/><MenuItem Header="3 stars" Tag="3" Click="OnContextRating"/><MenuItem Header="4 stars" Tag="4" Click="OnContextRating"/><MenuItem Header="5 stars" Tag="5" Click="OnContextRating"/>
                            </MenuItem>
                            <MenuItem Header="Color Label">
                                <MenuItem Header="6 · Red" Tag="Red" Click="OnContextColor"/><MenuItem Header="7 · Yellow" Tag="Yellow" Click="OnContextColor"/><MenuItem Header="8 · Green" Tag="Green" Click="OnContextColor"/><MenuItem Header="9 · Blue" Tag="Blue" Click="OnContextColor"/><MenuItem Header="T · Purple" Tag="Purple" Click="OnContextColor"/><Separator/><MenuItem Header="* · Clear color label" Tag="None" Click="OnContextColor"/>
                            </MenuItem>
                            <MenuItem Header="Flag as Pick" Tag="Pick" Click="OnContextFlag"/><MenuItem Header="Flag as Reject" Tag="Reject" Click="OnContextFlag"/><MenuItem Header="Remove flag" Tag="None" Click="OnContextFlag"/>
                            <Separator/>
                            <MenuItem Header="Rotate Left 90°" Click="OnRotateLeft"/><MenuItem Header="Rotate Right 90°" Click="OnRotateRight"/><MenuItem Header="Open in Loupe" Click="OnContextLoupe"/><MenuItem Header="Show in File Explorer" Click="OnContextReveal"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <ListBox x:Name="GridPhotos" Style="{StaticResource ReviewListBox}" SelectionMode="Extended" SelectionChanged="OnGridSelectionChanged" PreviewMouseRightButtonDown="OnGridRightClick" ItemsSource="{Binding FilteredPhotos}" SelectedItem="{Binding CurrentPhoto}" ItemTemplate="{StaticResource PhotoTile}" Visibility="{Binding IsGrid, Converter={StaticResource BoolVisibility}}" MouseDoubleClick="OnGridDoubleClick" Padding="8" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><review:VirtualizingPhotoPanel ItemWidth="{Binding TileWidth}" ItemHeight="{Binding TileHeight}"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    </ListBox>
                    <Grid x:Name="LoupeViewport" Visibility="{Binding IsLoupe, Converter={StaticResource BoolVisibility}}" ClipToBounds="True" PreviewMouseWheel="OnLoupeMouseWheel" PreviewMouseLeftButtonDown="OnLoupeMouseDown" PreviewMouseMove="OnLoupeMouseMove" PreviewMouseLeftButtonUp="OnLoupeMouseUp" LostMouseCapture="OnLoupeLostMouseCapture">
                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" Margin="18" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5"><Image.LayoutTransform><RotateTransform Angle="{Binding CurrentPhoto.Rotation}"/></Image.LayoutTransform><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}"/><TranslateTransform X="{Binding PanX}" Y="{Binding PanY}"/></TransformGroup></Image.RenderTransform></Image>
                        <Border Background="#DC151515" CornerRadius="3" Padding="8,4" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="20" IsHitTestVisible="False"><TextBlock Text="{Binding PreviewMessage}" Foreground="#DADADA" TextAlignment="Center"/></Border>
                        <Button Content="‹" Command="{Binding PreviousCommand}" FontSize="34" Padding="12,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12" Opacity="0.75"/>
                        <Button Content="›" Command="{Binding NextCommand}" FontSize="34" Padding="12,4" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" Opacity="0.75"/>
                    </Grid>
                    <Border x:Name="ReviewEmptyState" Panel.ZIndex="20" Background="#1C1C1C" Visibility="{Binding HasNoPhotos, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Width="430" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="58" Height="58" CornerRadius="8" Background="#292929" BorderBrush="#444" BorderThickness="1" HorizontalAlignment="Center"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="25" Foreground="#69B8E6" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock Text="Start with a photo folder" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,7"/>
                            <TextBlock Text="Import a folder or drop photos here. Your originals stay untouched while ratings and labels are saved in the local catalog." Foreground="#A8A8A8" TextAlignment="Center" LineHeight="19"/>
                            <Button Content="Import folder…" Command="{Binding ImportCommand}" Style="{StaticResource BlueButton}" HorizontalAlignment="Center" Padding="22,9" Margin="0,18,0,0"/>
                            <TextBlock Text="Next: review in Grid or Loupe, then export visible names or send them to TXT Filter." Foreground="#777" FontSize="10" TextAlignment="Center" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NoFilterResultsState" Panel.ZIndex="20" Background="#1C1C1C" Visibility="{Binding HasNoFilteredPhotos, Converter={StaticResource BoolVisibility}}">
                        <StackPanel Width="390" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="No photos match this filter" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Ratings and labels are still saved. Show all photos or choose another Photo Filter." Foreground="#999" TextAlignment="Center" Margin="0,8,0,16"/><Button Content="Show all photos" Command="{Binding ShowAllCommand}" HorizontalAlignment="Center" Padding="18,8"/></StackPanel>
                    </Border>
                    <Border Panel.ZIndex="30" Visibility="{Binding OverlayVisible, Converter={StaticResource BoolVisibility}}" Background="#E0181818" BorderBrush="#66FFFFFF" BorderThickness="1" CornerRadius="6" Padding="18,9" HorizontalAlignment="Center" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="VerticalAlignment" Value="Bottom"/><Setter Property="Margin" Value="20,0,20,28"/><Style.Triggers><DataTrigger Binding="{Binding OverlayPosition}" Value="1"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="20"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding OverlayMessage}" Foreground="White" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" Effect="{StaticResource StarOutline}"/></Border>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" Background="#151515" HorizontalAlignment="Stretch"/>
            <Border Grid.Column="4" Background="{StaticResource Panel}" BorderBrush="#111" BorderThickness="1,0,0,0">
                <TabControl x:Name="InspectorTabs" Background="{StaticResource Panel}" BorderThickness="0" Padding="0">
                    <TabItem Header="{Binding InspectorReviewLabel}"><ScrollViewer x:Name="ReviewInspectorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ReviewInspectorSections"><Expander Header="Histogram" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,2"><Border Height="92" Background="#191919" BorderBrush="#555" BorderThickness="1"><Grid><TextBlock Text="NO DATA" Foreground="#555" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image Source="{Binding HistogramImage}" Stretch="Fill"/></Grid></Border><TextBlock Text="{Binding HistogramSummary}" Foreground="#AFAFAF" FontSize="10" Margin="0,7,0,0"/><TextBlock Text="{Binding HistogramAssessment}" Foreground="#D6D6D6" FontSize="10" Margin="0,3,0,0"/></StackPanel></Expander><Expander Header="Rating &amp; Flags" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,3"><TextBlock Text="{Binding CurrentName}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding CurrentName}"/><TextBlock Text="{Binding CurrentDetails}" Foreground="#A0A0A0" FontSize="10" Margin="0,4,0,10" TextWrapping="Wrap"/><UniformGrid x:Name="RatingStars" Columns="5" MouseLeave="OnRatingLeave"><Button Content="★" Tag="1" Click="OnRateClick" MouseEnter="OnRatingHover" Foreground="{Binding DisplayRating, Converter={StaticResource RatingBrush}, ConverterParameter=1}" FontSize="18" Padding="3,2"/><Button Content="★" Tag="2" Click="OnRateClick" MouseEnter="OnRatingHover" Foreground="{Binding DisplayRating, Converter={StaticResource RatingBrush}, ConverterParameter=2}" FontSize="18" Padding="3,2"/><Button Content="★" Tag="3" Click="OnRateClick" MouseEnter="OnRatingHover" Foreground="{Binding DisplayRating, Converter={StaticResource RatingBrush}, ConverterParameter=3}" FontSize="18" Padding="3,2"/><Button Content="★" Tag="4" Click="OnRateClick" MouseEnter="OnRatingHover" Foreground="{Binding DisplayRating, Converter={StaticResource RatingBrush}, ConverterParameter=4}" FontSize="18" Padding="3,2"/><Button Content="★" Tag="5" Click="OnRateClick" MouseEnter="OnRatingHover" Foreground="{Binding DisplayRating, Converter={StaticResource RatingBrush}, ConverterParameter=5}" FontSize="18" Padding="3,2"/></UniformGrid><UniformGrid Columns="3" Margin="0,9,0,7"><Button Content="P Pick" Click="OnPick" Padding="4,7" Foreground="#7AD49A" Margin="0,0,2,0"/><Button Content="U Clear" Click="OnUnflag" Padding="4,7" Margin="2,0"/><Button Content="X Reject" Click="OnReject" Padding="4,7" Foreground="#F08080" Margin="2,0,0,0"/></UniformGrid><UniformGrid Columns="6"><Button Content="6" Tag="Red" Click="OnColorClick" Padding="2,7" Background="#873535" ToolTip="Red label"/><Button Content="7" Tag="Yellow" Click="OnColorClick" Padding="2,7" Background="#7F6927" Margin="3,0,0,0" ToolTip="Yellow label"/><Button Content="8" Tag="Green" Click="OnColorClick" Padding="2,7" Background="#2E7047" Margin="3,0,0,0" ToolTip="Green label"/><Button Content="9" Tag="Blue" Click="OnColorClick" Padding="2,7" Background="#2D6087" Margin="3,0,0,0" ToolTip="Blue label"/><Button Content="T" Tag="Purple" Click="OnColorClick" Padding="2,7" Background="#744D94" Margin="3,0,0,0" ToolTip="Purple label"/><Button Content="*" Tag="None" Click="OnColorClick" Padding="2,7" Margin="3,0,0,0" ToolTip="Clear color label"/></UniformGrid></StackPanel></Expander><Expander Header="Rotate &amp; Zoom" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,2"><UniformGrid Columns="2"><Button Content="Left 90°" Click="OnRotateLeft" Margin="0,0,2,0"/><Button Content="Right 90°" Click="OnRotateRight" Margin="2,0,0,0"/></UniformGrid><UniformGrid Columns="3" Margin="0,6,0,0"><Button Content="−" Click="OnZoomOut" ToolTip="Zoom out"/><Button Content="{Binding ZoomLabel}" Click="OnResetZoom" Margin="4,0" ToolTip="Reset zoom to Fit"/><Button Content="+" Click="OnZoomIn" ToolTip="Zoom in"/></UniformGrid></StackPanel></Expander><Expander Header="Deliver &amp; RAW Workflow" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,2"><TextBlock Text="CURRENT FILTER SCOPE" Foreground="#888" FontSize="9"/><TextBlock Text="{Binding VisibleScopeSummary}" Foreground="#D8D8D8" FontSize="10" Margin="0,4,0,9"/><Button Content="{Binding SendVisibleLabel}" Click="OnSendFilteredToFilter" Style="{StaticResource BlueButton}" ToolTip="Send every filename currently visible after Photo Filter"/><Button Content="{Binding ExportVisibleNamesLabel}" Command="{Binding ExportNamesCommand}" Margin="0,6,0,0"/><Border BorderBrush="#404040" BorderThickness="0,1,0,0" Margin="0,10,0,8"/><TextBlock Text="COPY RATED PHOTOS IN CURRENT VIEW" Foreground="#888" FontSize="9"/><ComboBox ItemsSource="{Binding ExportPolicies}" SelectedIndex="{Binding ExportPolicy}" Margin="0,6,0,6"/><Button Content="{Binding CopyVisibleRatedLabel}" Command="{Binding ExportRatedCommand}"/><Button Content="Open export folder" Command="{Binding OpenExportCommand}" Margin="0,6,0,0"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="{Binding InspectorToolsLabel}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><Expander Header="Review Session" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,2"><TextBlock Text="{Binding CatalogSummary}"/><TextBlock Text="Ratings, flags, color labels, and rotation are saved locally. Original files remain unchanged." Foreground="#A0A0A0" FontSize="10" Margin="0,6,0,8" LineHeight="15"/><Button Content="Show photo in File Explorer" Command="{Binding RevealCommand}"/></StackPanel></Expander><Expander Header="Storage &amp; Cache" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,2"><Button Content="Release preview memory" Command="{Binding ClearPreviewCacheCommand}"/><Button Content="Clear current review session…" Command="{Binding ClearSessionCommand}" Margin="0,6,0,0"/><Button Content="Open Windows Disk Cleanup…" Command="{Binding WindowsCacheCleanupCommand}" Margin="0,6,0,0"/></StackPanel></Expander><Expander Header="Keyboard Shortcuts" IsExpanded="True" Style="{StaticResource PanelExpander}"><StackPanel Margin="0,8,0,2"><TextBlock Text="0–5  Rating    ·    6–9 / T  Color&#x0a;Ctrl+F  Filmstrip&#x0a;P/X/U  Flags     ·    *  Clear color&#x0a;Ctrl+Z  Undo      ·    Tab  Hide panels" LineHeight="20"/><Button Content="View the full guide · F1" Click="OnShowHelp" Margin="0,8,0,0"/></StackPanel></Expander></StackPanel></ScrollViewer></TabItem>
                </TabControl>
            </Border>
        </Grid>

        <Border x:Name="FilmstripPanel" Grid.Row="2" Background="#151515" BorderBrush="#444" BorderThickness="0,1" Padding="8,0,8,7" Visibility="{Binding ShowFilmstrip, Converter={StaticResource BoolVisibility}}">
            <Grid><Grid.RowDefinitions><RowDefinition Height="7"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Thumb x:Name="FilmstripGrip" Cursor="SizeNS" DragDelta="OnFilmstripResize" DragCompleted="OnFilmstripResizeCompleted" ToolTip="{Binding FilmstripHint}"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#333"><Border Width="52" Height="2" Background="#777" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Thumb.Template></Thumb>
            <Grid Grid.Row="1">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <Button Content="‹" Command="{Binding PreviousCommand}" FontSize="20" Padding="4"/>
                <ListBox Grid.Column="1" x:Name="Filmstrip" Style="{StaticResource ReviewListBox}" Background="#151515" ItemsSource="{Binding FilteredPhotos}" SelectedItem="{Binding CurrentPhoto}" ItemTemplate="{StaticResource FilmTile}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="OnFilmstripSelectionChanged"><ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox>
                <Button Grid.Column="2" Content="›" Command="{Binding NextCommand}" FontSize="20" Padding="4"/>
            </Grid>
            </Grid></Grid>
        </Border>
        <Border Grid.Row="3" Background="#101010" Padding="12,0"><Grid><TextBlock Text="{Binding Status}" Foreground="#A8A8A8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/><TextBlock Text="{Binding PositionLabel}" Foreground="#DDD" HorizontalAlignment="Center" VerticalAlignment="Center"/><CheckBox Content="{Binding FilmstripLabel}" IsChecked="{Binding ShowFilmstrip}" ToolTip="{Binding FilmstripHint}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
        <ContentControl x:Name="FilterHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
        <Border x:Name="HelpOverlay" Panel.ZIndex="200" Visibility="Collapsed" Background="#B8000000" Padding="40">
            <Border Background="#262626" BorderBrush="#666" BorderThickness="1" CornerRadius="8" Width="820" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid><TextBlock Text="QiQi Studio Import &amp; Review Guide" FontSize="22" FontWeight="SemiBold" Foreground="White"/><TextBlock Text="{Binding HelpShortcut}" HorizontalAlignment="Right" Foreground="#8FC9EB" FontWeight="SemiBold" ToolTip="Press this shortcut again, or press Esc, to close"/></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18"><StackPanel>
                        <TextBlock Text="FROM JPG REVIEW TO RAW DELIVERY" Foreground="#6FC4F0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReviewGuideWorkflow" Text="1. Select Import folder, or drop photos or a folder anywhere in this window.&#x0a;2. Review in Grid. Double-click a photo or press Space to open Loupe; press Space again to return to Grid. Adjust thumbnail size below the Grid.&#x0a;3. Rate with 0–5, add color labels with 6–9 or T, and mark Pick/Reject with P/X/U. Hover over stars to preview a rating before clicking.&#x0a;4. Use Photo Filter to narrow the catalog. Resize the Filmstrip by dragging its top edge, or press Ctrl+F to hide/show it.&#x0a;5. In Review + Deliver, export visible names, send them to TXT Filter, or copy the rated photos currently visible.&#x0a;6. In TXT Filter, choose the RAW source and destination, scan the matches, preview results, then copy the selected files." Margin="0,8,0,12" LineHeight="21"/>
                        <TextBlock Text="For sharper detail: open Settings, choose Preview quality (up to Original), or enable Load original resolution when zooming. Quality changes apply immediately." Foreground="#B5B5B5" Margin="0,0,0,12"/><TextBlock Text="Your original photos and embedded metadata are never modified." Foreground="#82D0A2" Margin="0,0,0,18"/>
                        <TextBlock Text="REVIEW KEYBOARD SHORTCUTS" Foreground="#6FC4F0" FontWeight="SemiBold"/>
                        <Grid x:Name="ReviewGuideShortcuts" Margin="0,8,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                            <TextBlock Text="← → / ↑ ↓" Foreground="#DDD"/><TextBlock Grid.Column="1" Text="Previous/next photo · move up/down one Grid row"/>
                            <TextBlock Grid.Row="1" Text="0–5 / 6–9 / T / *" Foreground="#DDD"/><TextBlock Grid.Row="1" Grid.Column="1" Text="Rating · red/yellow/green/blue/purple label · clear color"/>
                            <TextBlock Grid.Row="2" Text="P / X / U" Foreground="#DDD"/><TextBlock Grid.Row="2" Grid.Column="1" Text="Pick · Reject · remove flag"/>
                            <TextBlock Grid.Row="3" Text="G / E / Space" Foreground="#DDD"/><TextBlock Grid.Row="3" Grid.Column="1" Text="Grid · Loupe · toggle Grid/Loupe"/>
                            <TextBlock Grid.Row="4" Text="Ctrl+F" Foreground="#DDD"/><TextBlock Grid.Row="4" Grid.Column="1" Text="Show or hide the Filmstrip"/>
                            <TextBlock Grid.Row="5" Text="{Binding UndoShortcut}" Foreground="#DDD"/><TextBlock Grid.Row="5" Grid.Column="1" Text="Undo the most recent review action"/>
                            <TextBlock Grid.Row="6" Text="Ctrl+[ / Ctrl+]" Foreground="#DDD"/><TextBlock Grid.Row="6" Grid.Column="1" Text="Rotate left / right by 90°"/>
                            <TextBlock Grid.Row="7" Text="Ctrl++ / Ctrl+-" Foreground="#DDD"/><TextBlock Grid.Row="7" Grid.Column="1" Text="Zoom in / out"/>
                            <TextBlock Grid.Row="8" Text="{Binding ResetZoomShortcut}" Foreground="#DDD"/><TextBlock Grid.Row="8" Grid.Column="1" Text="Reset to Fit · mouse wheel zooms toward the pointer"/>
                            <TextBlock Grid.Row="9" Text="{Binding ZenShortcut}" Foreground="#DDD"/><TextBlock Grid.Row="9" Grid.Column="1" Text="Show or hide both side panels"/>
                            <TextBlock Grid.Row="10" Text="{Binding HelpShortcut}" Foreground="#DDD"/><TextBlock Grid.Row="10" Grid.Column="1" Text="Open this guide · press Esc to close"/>
                            <TextBlock Grid.Row="11" Text="Ctrl+1 / Ctrl+2" Foreground="#DDD"/><TextBlock Grid.Row="11" Grid.Column="1" Text="Switch between Import &amp; Review and TXT Filter"/>
                        </Grid>
                        <TextBlock Text="MOUSE &amp; MULTI-SELECTION" Foreground="#6FC4F0" FontWeight="SemiBold"/>
                        <TextBlock x:Name="ReviewGuideMouse" Text="Use Ctrl+click to add or remove individual photos, or Shift+click to select a range. Double-click or press Space to open Loupe; press Space again to return to Grid. In Loupe, click once to zoom toward the pointer and click again to return to Fit. Use the mouse wheel for gradual pointer-centered zoom. While zoomed in, drag to inspect hidden areas. Right-click for export, rating, color, flag, and rotation actions." Margin="0,8,0,0" LineHeight="21"/>
                    </StackPanel></ScrollViewer>
                    <Button Grid.Row="2" Content="Close Guide" Click="OnCloseHelp" HorizontalAlignment="Right" Padding="18,8" Style="{StaticResource BlueButton}"/>
                </Grid>
            </Border>
        </Border>
        <Border x:Name="SettingsOverlay" Panel.ZIndex="210" Visibility="Collapsed" Background="#B8000000" Padding="40">
            <Border Background="#262626" BorderBrush="#666" BorderThickness="1" CornerRadius="8" Width="760" MaxHeight="760" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Photo Review Settings" FontSize="22" FontWeight="SemiBold" Foreground="White"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="APP LANGUAGE" Foreground="#6FC4F0" FontWeight="SemiBold"/><TextBlock Text="Interface language" Margin="0,10,0,5"/><ComboBox x:Name="LanguageCombo" SelectedValuePath="Tag" SelectionChanged="OnLanguageChanged"><ComboBoxItem Content="Tiếng Việt" Tag="vi"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><TextBlock Text="The app restarts after you confirm a language change." Foreground="#A0A0A0" FontSize="10" Margin="0,6,0,16"/><TextBlock Text="IMAGE DISPLAY" Foreground="#6FC4F0" FontWeight="SemiBold"/><TextBlock Text="Preview quality" Margin="0,12,0,5"/><ComboBox x:Name="PreviewQualityCombo" ItemsSource="{Binding PreviewQualityOptions}" SelectedValuePath="MaxEdge" SelectedValue="{Binding PreviewMaxEdge}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                            <TextBlock Text="Quality applies immediately to the current photo. Original keeps all decoded pixels and uses more RAM. Only the current photo is loaded at this quality." Foreground="#A0A0A0" FontSize="11" Margin="0,6,0,10"/>
                            <CheckBox IsChecked="{Binding FullResolutionOnZoom}"><TextBlock Text="Load original resolution when zooming"/></CheckBox>
                            <TextBlock Text="When zooming in Loupe, load full resolution for detail; return to the selected quality at Fit." Foreground="#A0A0A0" FontSize="11" Margin="0,5,0,8"/>
                            <TextBlock Text="RAW detail depends on the Windows codec or available JPG/embedded preview. The actual dimensions and source are shown below the image." Foreground="#A0A0A0" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="Mouse click zoom (%)" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding ClickZoomOptions}" SelectedItem="{Binding ClickZoomPercent}" ToolTip="Zoom level used when you click a photo in Loupe"/><TextBlock Text="Mouse wheel / keyboard zoom step (%)" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding ZoomStepOptions}" SelectedItem="{Binding ZoomStepPercent}"/><TextBlock Text="On-screen message duration (ms)" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding OverlayDurationOptions}" SelectedItem="{Binding OverlayDurationMs}"/><TextBlock Text="Message position" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding OverlayPositionOptions}" SelectedIndex="{Binding OverlayPosition}"/><TextBlock Text="Default view" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding DefaultViewOptions}" SelectedIndex="{Binding DefaultView}"/><CheckBox Content="Start with both side panels hidden" IsChecked="{Binding StartWithPanelsHidden}" Margin="0,14,0,0"/><CheckBox Content="Show histogram for the current preview" IsChecked="{Binding HistogramEnabled}"/><TextBlock Text="Changes are saved automatically." Foreground="#A0A0A0" FontSize="10" Margin="0,12,0,0"/></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="CUSTOM KEYBOARD SHORTCUTS" Foreground="#6FC4F0" FontWeight="SemiBold"/><TextBlock Text="Open guide" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding HelpShortcutOptions}" SelectedItem="{Binding HelpShortcut}"/><TextBlock Text="Show/hide side panels" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding ZenShortcutOptions}" SelectedItem="{Binding ZenShortcut}"/><TextBlock Text="Undo last review action" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding UndoShortcutOptions}" SelectedItem="{Binding UndoShortcut}"/><TextBlock Text="Reset zoom to Fit" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding ResetZoomShortcutOptions}" SelectedItem="{Binding ResetZoomShortcut}"/><TextBlock Text="Switch to Grid" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding GridShortcutOptions}" SelectedItem="{Binding GridShortcut}"/><TextBlock Text="Switch to Loupe" Margin="0,10,0,5"/><ComboBox ItemsSource="{Binding LoupeShortcutOptions}" SelectedItem="{Binding LoupeShortcut}"/><TextBlock Text="Keys 0–9, *, P/X/U, and the arrow keys stay fixed to prevent command conflicts." Foreground="#A0A0A0" FontSize="10" Margin="0,12,0,0"/></StackPanel>
                    </Grid></ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Restore Defaults" Click="OnResetSettings"/><Button Content="Close" Click="OnCloseSettings" Style="{StaticResource BlueButton}" Margin="8,0,0,0" Padding="20,8"/></StackPanel>
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
