<Window x:Class="PhotoFileFilter.LanguageWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="QiQi Studio · Language" Icon="Assets/qiqistudio.ico" Width="560" Height="390" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Background="#1E1E1E" Foreground="#F2F2F2" FontFamily="Segoe UI">
    <Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center"><Border Background="White" CornerRadius="12" Width="64" Height="64"><Image Source="Assets/qiqistudio_nobackground.png"/></Border><TextBlock Text="Choose your language" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,15,0,3"/><TextBlock Text="Chọn ngôn ngữ sử dụng" Foreground="#A9A9A9" FontSize="15" HorizontalAlignment="Center"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,24,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Button Click="OnVietnamese" Padding="18" Background="#287CAD" BorderBrush="#55B6ED" Foreground="White"><StackPanel><TextBlock Text="Tiếng Việt" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Khuyên dùng" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
            <Button Grid.Column="2" Click="OnEnglish" Padding="18" Background="#383838" BorderBrush="#606060" Foreground="White"><StackPanel><TextBlock Text="English" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="Use English interface" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0"/></StackPanel></Button>
        </Grid>
        <TextBlock Grid.Row="2" Text="You can change this later in Settings.  ·  Có thể đổi lại trong Cài đặt." Foreground="#999" HorizontalAlignment="Center"/>
    </Grid>
</Window>
