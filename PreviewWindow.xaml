<Window x:Class="PhotoFileFilter.PreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Photo Preview · QiQi Studio" Icon="Assets/qiqistudio.ico" Width="900" Height="680" MinWidth="520" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" KeyDown="OnPreviewKeyDown">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,15"><Button DockPanel.Dock="Right" Content="Show in File Explorer ↗" Click="OnReveal"/><StackPanel><TextBlock x:Name="FileTitle" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Press Space or Esc to close" Style="{StaticResource Caption}" Margin="0,5,0,0"/></StackPanel></DockPanel>
        <Border Grid.Row="1" Background="{DynamicResource C14232B}" CornerRadius="12" Padding="12"><Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
        <TextBlock Grid.Row="2" x:Name="PreviewDescription" Text="Loading photo…" Margin="0,14,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>

