<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.24.1</Version>
    <Product>QiQi Studio — Photo File Filter</Product>
    <Company>QiQi Studio</Company>
    <ApplicationIcon>Assets\qiqistudio.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DefaultItemExcludes>$(DefaultItemExcludes);.tools/**;artifacts/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Core\**;Tests\**;.tools\**" />
    <EmbeddedResource Remove="Core\**;Tests\**;.tools\**" />
    <None Remove=".tools\**;Tests\**" />
    <ProjectReference Include="Core\PhotoFileFilter.Core.csproj" />
    <Resource Include="Assets\qiqistudio_nobackground.png" />
    <Resource Include="Assets\qiqistudio.ico" />
  </ItemGroup>

</Project>
