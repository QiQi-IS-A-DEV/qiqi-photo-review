<Window x:Class="PhotoFileFilter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QiQi Studio · Filter Photos by TXT List" Icon="Assets/qiqistudio.ico"
        Width="1280" Height="900" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CF3F5F3}" Foreground="{DynamicResource C20343F}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="OnMainKeyDown">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding BrowseTxtCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
    </Window.InputBindings>
    <Grid Background="{DynamicResource CF3F5F3}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Studio identity. The original PNG is embedded, independent of the source logo folder. -->
        <Border Background="{DynamicResource C172E38}" Padding="22,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="#FFFFFF" CornerRadius="10" Width="46" Height="46" Margin="0,0,14,0"><Image Source="Assets/qiqistudio_nobackground.png" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Logo QiQi Studio"/></Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Help" Click="OnHelp" Margin="0,0,8,0" Padding="12,8" ToolTip="Open the TXT Filter guide (F1)"/><Button Content="Clear session" Click="OnClearFilterSession" Margin="0,0,10,0" Padding="12,8" ToolTip="Clear saved paths, the TXT list, and current results"/><CheckBox x:Name="ThemeToggle" Content="Dark theme" IsChecked="{Binding DarkMode}" Foreground="{DynamicResource CACBFC3}" FontSize="11" Margin="0,0,18,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Filter Photos by TXT List" Foreground="White" FontWeight="SemiBold" FontSize="20"/><StackPanel Orientation="Horizontal"><TextBlock Text="QIQI STUDIO  ·  1.20" Foreground="{DynamicResource CACBFC3}" FontSize="9" Margin="0,0,10,0"/><TextBlock Text="{Binding WorkflowHint}" Foreground="#7FC5EA" FontSize="10" FontWeight="SemiBold" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding WorkflowHint}"/></StackPanel></StackPanel></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ReviewNavigationButton" Content="Import &amp; Review  ·  Ctrl+1" Click="OnOpenReview" Margin="0,0,7,0" Padding="14,8" ToolTip="Switch to the Import &amp; Review workspace (Ctrl+1)"/>
                    <Border Background="#287CAD" BorderBrush="#3B9BD6" BorderThickness="1" CornerRadius="4" Padding="14,8" Margin="0,0,12,0"><TextBlock Text="TXT Filter  ·  Ctrl+2" Foreground="White" FontWeight="SemiBold" TextWrapping="NoWrap"/></Border>
                    <Border Background="{DynamicResource C26443F}" CornerRadius="12" Padding="12,6"><TextBlock Text="✓ Originals stay untouched" Foreground="{DynamicResource CBDE2CE}" FontSize="11"/></Border>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18,16,18,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- The settings column scrolls independently, leaving the results and copy action in view. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                <StackPanel IsEnabled="{Binding Idle}">
                    <Border Style="{StaticResource Card}" Padding="18" Tag="txt" AllowDrop="True" PreviewDragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource Step}"><TextBlock Text="01" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                <TextBlock Text="Filename List" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Command="{Binding BrowseTxtCommand}" Background="{DynamicResource CF5F9F6}" BorderBrush="{DynamicResource CD8E7DF}" Padding="11" HorizontalContentAlignment="Stretch" ToolTip="{Binding TxtFileHint}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource C3F8A73}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding TxtFileName}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="TXT · drop here or click to browse" Style="{StaticResource Caption}" FontSize="10" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <TextBlock Text="SEPARATE FILENAMES BY" Style="{StaticResource Eyebrow}" Margin="0,12,0,6"/>
                            <WrapPanel>
                                <CheckBox Content="Comma" IsChecked="{Binding Comma}" FontSize="11"/>
                                <CheckBox Content="Space or tab" IsChecked="{Binding Space}" FontSize="11"/>
                                <CheckBox Content="New line" IsChecked="{Binding NewLine}" FontSize="11"/>
                            </WrapPanel>
                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <CheckBox Content="Ignore file extensions in TXT" IsChecked="{Binding IgnoreExtension}" FontSize="12"/>
                                    <TextBlock Text="IMG_1001.JPG becomes IMG_1001, so it can match JPG and RAW files with the same name." Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" LineHeight="16"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0" Tag="source" AllowDrop="True" PreviewDragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Border Style="{StaticResource Step}"><TextBlock Text="02" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
                                <TextBlock Text="Source Photos" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock Text="FILE TYPES" Style="{StaticResource Eyebrow}" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="JPG" Command="{Binding SelectJpgCommand}" Style="{StaticResource QuietButton}"/>
                                    <Button Content="RAW" Command="{Binding SelectRawCommand}" Style="{StaticResource QuietButton}"/>
                                    <Button Content="All" Command="{Binding SelectAllCommand}" Style="{StaticResource QuietButton}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Extensions}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}" Style="{StaticResource ExtensionChip}"/></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="SOURCE FOLDER" Style="{StaticResource Eyebrow}" Margin="0,12,0,7"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Command="{Binding BrowseSourceCommand}" Margin="6,0,0,0" Padding="11" ToolTip="Choose the source photo folder" AutomationProperties.Name="Choose source folder"><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16"/></Button>
                                <TextBox Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding SourceHint}" AutomationProperties.Name="Source folder" FontSize="12"/>
                            </DockPanel>
                            <TextBlock Text="You can also drop a photo folder in this area." Style="{StaticResource Caption}" FontSize="10" Margin="0,6,0,9"/>
                            <CheckBox Content="Search subfolders" IsChecked="{Binding Recursive}" FontSize="12"/>
                            <Button Command="{Binding ScanCommand}" Style="{StaticResource PrimaryButton}" Margin="0,15,0,0" ToolTip="Scan photos (F5)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Scan Photos"/><TextBlock Text="F5" Opacity="0.55" FontSize="10" Margin="16,2,0,0"/></StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                <Border x:Name="OutputSettings" Style="{StaticResource Card}" Padding="16" Margin="0,14,0,0" IsEnabled="{Binding Idle}" Tag="output" AllowDrop="True" PreviewDragOver="OnFileDragOver" DragLeave="OnFileDragLeave" Drop="OnFileDrop">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionSummary}" Foreground="{DynamicResource C5D8673}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal"><Border Style="{StaticResource Step}"><TextBlock Text="03" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Destination" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></StackPanel>
                        </DockPanel>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton Content="Inside source folder" IsChecked="{Binding Alongside}" GroupName="Output" FontSize="12"/>
                            <RadioButton Content="Different folder" IsChecked="{Binding SpecificFolder}" GroupName="Output" FontSize="12"/>
                        </WrapPanel>
                        <DockPanel Margin="0,0,0,10" Visibility="{Binding SpecificFolder, Converter={StaticResource BoolVisibility}}">
                                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseOutputCommand}" Margin="7,0,0,0" Padding="12,8" FontSize="11"/>
                                <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" FontSize="12" AutomationProperties.Name="Destination folder"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <CheckBox Content="Create subfolder" IsChecked="{Binding UseSubfolder}" IsEnabled="{Binding SpecificFolder}" FontSize="11" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding SubfolderName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding NeedsSubfolder}" FontSize="12" AutomationProperties.Name="Subfolder name"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="WHEN A FILE ALREADY EXISTS" Style="{StaticResource Eyebrow}" Margin="0,2,0,9"/>
                                <ComboBox Style="{StaticResource AppComboBox}" ItemsSource="{Binding Policies}" SelectedIndex="{Binding Policy}" Padding="10,8" FontSize="12" AutomationProperties.Name="File conflict policy"/>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding Readiness}" Foreground="{DynamicResource C658170}" FontSize="10" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding DestinationPreview}" ToolTip="{Binding DestinationPreview}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                </StackPanel>

                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                </StackPanel>
            </ScrollViewer>

            <Grid Grid.Column="2">

                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,15">
                            <Button DockPanel.Dock="Right" Content="↗  Save Report" Command="{Binding ExportCommand}" Style="{StaticResource QuietButton}"/>
                            <TextBlock Text="Match Results" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Grid.Row="1"><UniformGrid Columns="3" Margin="0,0,0,12">
                            <Border Background="{DynamicResource CF2F5F7}" CornerRadius="10" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding RequestedCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Requested names" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
                            <Border Background="{DynamicResource CEAF4ED}" CornerRadius="10" Padding="14,10" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding MatchedCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource C247650}"/><TextBlock Text="Files found" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
                            <Border Background="{DynamicResource CFBF4E7}" CornerRadius="10" Padding="14,10"><StackPanel><TextBlock Text="{Binding MissingCount, StringFormat={}{0:N0}}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource CA87928}"/><TextBlock Text="Names not found" Style="{StaticResource Caption}" FontSize="11"/></StackPanel></Border>
                        </UniformGrid><TextBlock Text="{Binding FormatBreakdown}" FontSize="11" Foreground="{DynamicResource C5D8673}" Margin="0,0,0,8"/></StackPanel>
                        <DockPanel Grid.Row="2" Margin="0,0,0,5">
                            <Button DockPanel.Dock="Right" Content="×" Command="{Binding ClearSearchCommand}" Style="{StaticResource QuietButton}" FontSize="18" ToolTip="Clear search" AutomationProperties.Name="Clear search"/>
                            <Grid>
                                <TextBox x:Name="SearchBox" Tag="Search by filename or folder…" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=180}" Padding="32,8,10,8" FontSize="12" AutomationProperties.Name="Search results"/>
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource C8B9B92}" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
                                
                            </Grid>
                        </DockPanel>
                        <Grid Grid.Row="3">
                            <TabControl BorderThickness="0" Background="{DynamicResource Surface}" Padding="0,8,0,0">
                                <TabItem Header="{Binding FilesTab}">
                                    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding VisibleFiles}" SelectedItem="{Binding SelectedFile}" AutomationProperties.Name="Files found" PreviewMouseRightButtonDown="OnResultsRightClick" MouseDoubleClick="OnResultsDoubleClick" PreviewKeyDown="OnResultsKeyDown">
    <DataGrid.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
        <MenuItem Header="Preview (Space)" Command="{Binding PreviewCommand}"/>
        <MenuItem Header="Show in File Explorer" Command="{Binding RevealFileCommand}"/>
        <MenuItem Header="Copy full path" Command="{Binding CopyPathCommand}"/>
        <Separator/>
        <MenuItem Header="{Binding ToggleIncludedLabel}" Command="{Binding ToggleIncludedCommand}"/>
        <MenuItem Header="Include all files" Command="{Binding IncludeAllCommand}"/>
    </ContextMenu></DataGrid.ContextMenu>
                                        <DataGrid.Columns>
    <DataGridTemplateColumn Header="COPY" Width="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding IncludeInCopy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding DataContext.Idle, RelativeSource={RelativeSource AncestorType=DataGrid}}" Margin="0" AutomationProperties.Name="Include file in copy"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                            <DataGridTextColumn Header="NAME / FOLDER" Binding="{Binding RelativePath}" Width="*"/>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding FileType}" Width="58"/>
                                            <DataGridTextColumn Header="SIZE" Binding="{Binding SizeLabel}" Width="105"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="{Binding MissingTab}"><DockPanel>
                                    <Button DockPanel.Dock="Top" Content="Copy all missing names" Command="{Binding CopyMissingCommand}" HorizontalAlignment="Left" Margin="0,3,0,8" FontSize="11"/>
                                    <ListBox ItemsSource="{Binding VisibleMissing}" BorderThickness="0" Padding="8" FontFamily="Consolas" FontWeight="Normal" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"/>
                                </DockPanel></TabItem>
                                <TabItem Header="{Binding IssuesTab}"><ListBox ItemsSource="{Binding Issues}" BorderThickness="0" Padding="8" FontWeight="Normal" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="4" Foreground="{DynamicResource C9B5B20}"/></DataTemplate></ListBox.ItemTemplate></ListBox></TabItem>
                            </TabControl>
                            <Border Background="{DynamicResource Surface}" Margin="0,43,0,0" Visibility="{Binding HasNoResults, Converter={StaticResource BoolVisibility}}" IsHitTestVisible="False">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource CEFF5F0}" Width="48" Height="48" CornerRadius="6" HorizontalAlignment="Center" Margin="0,0,0,11"><TextBlock Text="&#xEB9F;" FontFamily="Segoe MDL2 Assets" FontSize="23" Foreground="{DynamicResource C8CA999}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Text="Bring every selected photo into one place." FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Add a filename list and scan your source folder to begin." Style="{StaticResource Caption}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="4" Text="{Binding FilterSummary}" Style="{StaticResource Caption}" FontSize="10" Margin="0,9,0,0"/>
                    </Grid>
                </Border>


            </Grid>
        </Grid>

        <!-- Primary actions are outside every ScrollViewer, including at laptop-sized viewports. -->
        <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="680"/>
                        <TextBlock Text="{Binding DestinationPreview}" ToolTip="{Binding DestinationPreview}" Style="{StaticResource Caption}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,3,0,0" MaxWidth="680"/>
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding Scanning}" Maximum="100" Height="3" Foreground="{DynamicResource C127C74}" Background="{DynamicResource CEDF3EF}" BorderThickness="0" Margin="0,7,0,0"/>
                    <TextBlock Text="{Binding CurrentFile}" FontSize="10" Foreground="{DynamicResource C74838B}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,7,0" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
                        <Button Content="Destination…" Click="OnShowOutput" FontSize="12" Margin="0,0,7,0"/><Button Content="Open Folder ↗" Command="{Binding OpenDestinationCommand}" FontSize="12" Margin="0,0,7,0"/>
                        <Button x:Name="CopyAction" Content="{Binding CopyLabel}" Command="{Binding CopyCommand}" Style="{StaticResource PrimaryButton}"/>
                    </StackPanel>
                    <CheckBox Content="Play sound when finished" IsChecked="{Binding CompletionSound}" FontSize="10" HorizontalAlignment="Right" Margin="0,7,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="FilterHelpOverlay" Grid.RowSpan="3" Panel.ZIndex="100" Background="#A6000000" Visibility="Collapsed">
            <Border Width="760" MaxHeight="720" Margin="24" Padding="24" CornerRadius="12" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock DockPanel.Dock="Right" Text="F1" Foreground="{DynamicResource C5D8673}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="QiQi Studio TXT Filter Guide" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Match a filename list with JPG or RAW originals, then copy the files into one folder." Style="{StaticResource Caption}" Margin="0,4,0,0"/></StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="WORKFLOW" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource C3F8A73}" Margin="0,0,0,9"/>
                            <TextBlock TextWrapping="Wrap" LineHeight="21"><Run FontWeight="SemiBold" Text="1. Add the filename list. "/><Run Text="Choose a TXT file or drop it onto Filename List. The list can contain names such as IMG_1001 or IMG_1002.JPG."/></TextBlock>
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"><Run FontWeight="SemiBold" Text="2. Set the matching rules. "/><Run Text="Choose how names are separated. Keep Ignore file extensions enabled when a JPG list should find RAW files with the same base name."/></TextBlock>
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"><Run FontWeight="SemiBold" Text="3. Choose the source photos. "/><Run Text="Select JPG, RAW, All, or individual file types. Choose the folder that contains the originals and enable Search subfolders when needed."/></TextBlock>
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"><Run FontWeight="SemiBold" Text="4. Scan and check the results. "/><Run Text="Select Scan Photos or press F5. Review Files Found, Not Found, and Notes / Errors. Clear the COPY check box for any file you do not want to copy."/></TextBlock>
                            <TextBlock TextWrapping="Wrap" LineHeight="21" Margin="0,8,0,0"><Run FontWeight="SemiBold" Text="5. Copy the selected files. "/><Run Text="Choose the destination and the action for duplicate filenames, then select Copy Photos and confirm the summary."/></TextBlock>

                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,16,0,14"/>
                            <TextBlock Text="MATCHING NOTES" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource C3F8A73}" Margin="0,0,0,8"/>
                            <TextBlock Text="• Matching is not case-sensitive.&#x0a;• With extensions ignored, IMG_1001.JPG can match IMG_1001.CR3 or IMG_1001.ARW.&#x0a;• The TXT file should contain filenames, not full folder paths.&#x0a;• QiQi Studio copies selected files and never modifies the originals." TextWrapping="Wrap" LineHeight="21"/>

                            <TextBlock Text="SHORTCUTS" Style="{StaticResource Eyebrow}" Foreground="{DynamicResource C3F8A73}" Margin="0,16,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock FontFamily="Consolas" Text="Ctrl+1 / Ctrl+2&#x0a;Ctrl+O&#x0a;F5&#x0a;Space&#x0a;Esc / F1" LineHeight="21"/>
                                <TextBlock Grid.Column="1" Text="Switch between Review and TXT Filter&#x0a;Choose a TXT list&#x0a;Scan the source folder&#x0a;Preview the selected result&#x0a;Cancel an operation / close this guide" LineHeight="21"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Row="2" Content="Close Guide" Click="OnCloseFilterHelp" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Padding="18,9"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>


